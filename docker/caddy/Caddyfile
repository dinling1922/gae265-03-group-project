# DOMAIN 是真實網域時，Caddy 自動向 Let's Encrypt 申請憑證（VM 的 80、443 要對外開放）；
# 本機驗證用 localhost，憑證由 Caddy 內建 CA 簽發（瀏覽器會警告，curl 用 -k）
{$DOMAIN:localhost} {
	encode

	handle /api/* {
		reverse_proxy backend:8000
	}

	# MCP 伺服器（ADR-0032、0034）：外部 AI 助理用存取權杖連的端點。不在 /api/v1 底下，沒有這段會落到下面的 SPA 回 HTML
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	# LINE bot 的 webhook（ADR-0033）：LINE 平台打過來，驗簽在後端
	handle /line/webhook {
		reverse_proxy backend:8000
	}

	# Flower（ADR-0031）：看提醒信的背景工作；帳號密碼由 Flower 檢查（.env 的 FLOWER_BASIC_AUTH）
	redir /flower /flower/ 308
	handle /flower/* {
		reverse_proxy flower:5555
	}

	# SPA：找不到的路徑都回 index.html，深層路由重新整理不會 404
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
